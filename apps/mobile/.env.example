# Jarvis wake word (Picovoice built-in "Jarvis" keyword).
# Create a key at https://console.picovoice.ai/ and set it here, then restart Expo.
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=
# Optional custom Porcupine models for exact phrases (Android assets or iOS bundle paths).
# The built-in JARVIS keyword already detects both "Hey Jarvis" and "Hello Jarvis".
# EXPO_PUBLIC_JARVIS_WAKE_MODELS=hey_jarvis_android.ppn,hello_jarvis_android.ppn
