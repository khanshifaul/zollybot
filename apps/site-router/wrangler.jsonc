{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zollybot-site-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.zollybot.site/*",
      "zone_name": "zollybot.site"
    }
  ],
  "vars": {
    // The account service origin. The report route `/_zollybot/report` and the links on error pages use it.
    "ACCOUNT_ORIGIN": "https://zollybot.shifaul.dev"
  },
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "zollybot-sites",
      "preview_bucket_name": "zollybot-sites-test"
    }
  ]
}
