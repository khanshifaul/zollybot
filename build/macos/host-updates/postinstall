#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/ZollyBot/HostManager'
"$ROOT/zollybot-host" --verify-installation
# Payload files have explicit root:wheel modes. Never recurse through tenant status or homes.
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.zollybot.host-manager.plist
fi
echo 'ZollyBot Host installed. Run sudo zollybot-host setup, then sudo zollybot-host verify.'
