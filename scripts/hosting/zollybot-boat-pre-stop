#!/bin/bash
# zollybot-boat-pre-stop: installed by zollybot-hosted-update. Changes to this file are replaced.
#
# boat runs /home/user/.boat/pre-stop as the sandbox user when a stop starts, waits for it to end (at
# most 60 seconds), and then saves the disk. boat supports this hook, but its documentation does not
# show it yet. The save copies files while they change, and a file that changed during the copy is
# restored torn. A database that ZollyBot wrote during the save was restored damaged. When ZollyBot is
# stopped first, the save sees no writes. boat can cancel the stop after this hook, for example when
# it cannot pause a Docker container that restarts. The machine then runs on with ZollyBot stopped, so a
# timer starts ZollyBot again (below).
set -u

# The flag stops the starts until boat saves the disk: the Restart= of the unit, and the start at the
# end of an update request (zollybot.service). /run is empty at each boot. boat can also keep the
# stopped machine in memory and continue it with no boot; then the account server removes the flag
# and starts ZollyBot (HELD_RESUME_START_COMMAND in apps/auth-api).
sudo -n touch /run/zollybot-pre-stop || exit 1
# The timer starts ZollyBot 15 minutes after the last hook when the flag is still there. boat runs this
# hook again before each new try of the stop, which touches the flag and sets a new timer. The start
# skips a flag that is 5 minutes old or less, so it does not start ZollyBot while boat saves the disk. A
# machine that stopped runs no timer. A held machine that the account server started has no flag, so the
# timer does nothing. The command has no `$`: systemd would replace it.
sudo -n systemctl stop zollybot-pre-stop-restart.timer 2>/dev/null
sudo -n systemd-run --quiet --collect --unit=zollybot-pre-stop-restart --on-active=15min /bin/sh -c \
  'if find /run/zollybot-pre-stop -mmin +5 2>/dev/null | grep -q .; then rm -f /run/zollybot-pre-stop && systemctl start --no-block zollybot.service; fi' ||
  echo "The start after a cancelled stop is not set." >&2
# The unit stops ZollyBot with SIGTERM, and ZollyBot closes its database last. ZollyBot exits after 30
# seconds by itself. The 60 seconds of TimeoutStopSec are too long for the limit of boat. A killed
# ZollyBot leaves a database that SQLite recovers, because no copy runs while it ends.
if sudo -n timeout 40 systemctl stop zollybot.service; then exit 0; fi
sudo -n systemctl kill --signal=SIGKILL zollybot.service
for _ in $(seq 1 10); do
  case $(systemctl show --property=ActiveState --value zollybot.service) in
    inactive | failed) exit 0 ;;
  esac
  sleep 0.5
done
exit 1
