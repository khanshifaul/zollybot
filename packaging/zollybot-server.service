[Unit]
Description=ZollyBot server (keeps the office running without a window)
Documentation=https://zollybot.shifaul.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Server mode opens the control socket the terminal frontend and the phone use.
Environment=ZOLLYBOT_SERVER=1
# Run with the user's own runtime directory, so the socket is private to them.
Environment=XDG_RUNTIME_DIR=%t
ExecStart=%h/.local/lib/zollybot/zollybot --server --ozone-platform=headless
# The window's handover stops this unit; a fast restart keeps the office up
# even when the exit code is 0 (a stale singleton lock during handover).
Restart=always
RestartSec=2
# A crash loop should not fill the journal.
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=default.target
