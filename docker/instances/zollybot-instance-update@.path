# The app of instance %i asks for an update with an empty file in update-requests.
# `zollybot-instance start` enables this unit for each instance.
[Unit]
Description=Update requests of ZollyBot instance %i

[Path]
PathExists=/srv/zollybot/%i/update-requests/update-stage
PathExists=/srv/zollybot/%i/update-requests/update-install

[Install]
WantedBy=paths.target
