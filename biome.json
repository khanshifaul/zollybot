{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "plugins": [
    "./tools/biome/anti-slop/rules/no-known-value-widening.grit",
    "./tools/biome/anti-slop/rules/no-module-mocking.grit",
    "./tools/biome/anti-slop/rules/no-object-parameters.grit",
    "./tools/biome/anti-slop/rules/no-reflect-escapes.grit",
    "./tools/biome/anti-slop/rules/no-unknown-returns.grit",
    "./tools/biome/anti-slop/rules/no-unknown-type-aliases.grit",
    "./tools/biome/anti-slop/rules/no-unsafe-dictionary-type.grit"
  ],
  "files": {
    "includes": [
      "**",
      "!!.codex",
      "!!.claude",
      "!!.gitnexus",
      "!node_modules",
      "!!out",
      "!!out-*",
      "!!build",
      "!!dist",
      "!!storybook-static",
      "!!**/dist",
      "!!**/.wrangler",
      "!!apps/mobile/.expo",
      "!!apps/mobile/android",
      "!!apps/mobile/ios",
      "!!apps/mobile/qvac",
      "!apps/mobile/expo-env.d.ts",
      "!apps/mobile/src/uniwind-types.d.ts",
      "!**/routeTree.gen.ts",
      "!tools/biome/anti-slop",
      "!tools/ui-foundation/fixtures",
      "!!coverage",
      "!!.zollybot-build",
      "!!Agents",
      "!!Bots",
      "!!Shared",
      "!!.worktrees",
      "!!.agents",
      "!!apps/desktop/build-resources/cua-driver",
      "!!apps/desktop/build-resources/remote-desktop-runtime",
      "!apps/desktop/src/renderer/src/vendor",
      "!packages/whatsapp/vendor",
      "!marketplace/production-catalog/bundles",
      "!!apps/web/components/ui",
      "!!apps/web/.next",
      "!!apps/web/out",
      "!apps/web/app/globals.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Textarea", "NativeSelect"]
          }
        }
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisleadingReturnType": "off",
        "noUnsafeTypeAssertion": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useAsConstAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error",
        "noSkippedTests": "warn"
      },
      "correctness": {
        "noReactNativeRawText": "off",
        "useReactNativePlatformComponents": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/contracts/src/**/*.ts",
        "packages/team-client/src/**/*.ts",
        "!packages/contracts/src/**/*.test.ts",
        "!packages/team-client/src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/**/*.ts",
        "packages/**/*.ts",
        "!scripts/build-remote-desktop-runtime.ts",
        "!scripts/create-remote-desktop-release-manifest.ts",
        "!scripts/native-runtime-lock.ts",
        "!scripts/package-remote-desktop-runtime.ts",
        "!scripts/remote-desktop-runtime-release.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/src/**/*.ts",
        "apps/desktop/src/renderer/src/**/*.tsx",
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/main/**", "**/backend/**", "**/preload/**"],
                    "message": "The renderer reaches main only through the IPC contract. Declare a channel in packages/contracts and go through window.zollybot."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/main/**/*.ts",
        "apps/desktop/src/backend/**/*.ts",
        "apps/desktop/src/preload/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/renderer/**"],
                    "message": "Nothing behind the trust boundary imports renderer code. Share the type through packages/contracts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/contracts/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "electron",
                      "electron/**",
                      "solid-js",
                      "solid-js/**",
                      "@solidjs/**",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "@anthropic-ai/**",
                      "@openai/**",
                      "openai",
                      "**/apps/desktop/src/main/**",
                      "**/apps/desktop/src/backend/**",
                      "**/apps/desktop/src/preload/**",
                      "**/apps/desktop/src/renderer/**",
                      "**/apps/**"
                    ],
                    "message": "Contracts are shared by every surface. Keep them free of Electron, SolidJS, provider, Cloudflare and application code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": [
        "./tools/biome/anti-slop/rules/no-class-assertions.grit",
        "./tools/biome/anti-slop/rules/no-style-assertions.grit",
        "./tools/biome/anti-slop/rules/no-dom-containment-assertions.grit",
        "./tools/biome/anti-slop/rules/no-title-copy-assertions.grit",
        "./tools/biome/anti-slop/rules/no-active-element-assertions.grit",
        "./tools/biome/anti-slop/rules/no-inner-html-assertions.grit",
        "./tools/biome/anti-slop/rules/no-dom-traversal-assertions.grit",
        "./tools/biome/anti-slop/rules/no-icon-query-assertions.grit",
        "./tools/biome/anti-slop/rules/no-snapshot-tests.grit",
        "./tools/biome/anti-slop/rules/no-testid-queries.grit",
        "./tools/biome/anti-slop/rules/no-class-selector-queries.grit",
        "./tools/biome/anti-slop/rules/no-sleep-in-tests.grit"
      ]
    },
    {
      "includes": ["apps/desktop/src/renderer/**", "packages/ui/**", "packages/brand/**", ".storybook/**"],
      "plugins": [
        "./tools/biome/anti-slop/rules/no-collections-in-stores.grit",
        "./tools/biome/anti-slop/rules/no-cleanup-in-effect-callbacks.grit"
      ]
    },
    {
      "includes": ["**/*.stories.ts", "**/*.stories.tsx"],
      "plugins": ["./tools/ui-foundation/no-story-play.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/renderer/src/**/*.ts",
        "apps/desktop/src/renderer/src/**/*.tsx",
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx",
        "apps/mobile/src/**/*.ts",
        "apps/mobile/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.tsx",
        "!apps/desktop/src/renderer/src/preview/**",
        "!apps/desktop/src/renderer/src/setupTests.ts",
        "!apps/mobile/src/features/servers/screens/office-screen.tsx"
      ],
      "plugins": ["./tools/ui-foundation/no-hardcoded-ui-text.grit"],
      "linter": {
        "rules": {
          "correctness": {}
        }
      }
    },
    {
      "includes": ["packages/ui/src/**/*.ts", "packages/ui/src/**/*.tsx"],
      "plugins": ["./tools/ui-foundation/no-desktop-preload.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/renderer/**", "**/main/**", "**/backend/**", "**/preload/**"],
                    "message": "Shared UI receives data and actions through props; do not import application or platform implementations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/**/*.ts", "apps/mobile/src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lucide-react-native": {
                    "allowImportNames": ["LucideIcon", "LucideProps"],
                    "message": "Metro does not remove unused exports, so this index adds every icon to the mobile bundle. Import one icon from \"lucide-react-native/icons/<name>\"."
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    },
    "jsxRuntime": "transparent"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
